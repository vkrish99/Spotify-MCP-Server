# Create an app at https://developer.spotify.com/dashboard
# Add http://127.0.0.1:8888/callback as a Redirect URI on that app.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Left blank until you run the one-time auth bootstrap (see README) --
# it writes this value into your local .env automatically.
SPOTIFY_REFRESH_TOKEN=
